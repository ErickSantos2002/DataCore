# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ===== AUTENTICAÇÃO =====
# Chave dos JWT. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Tem que ser DIFERENTE da SECRET_KEY do authapi. Mínimo de 32 caracteres — o app
# recusa subir (ValidationError) com uma chave mais curta.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
# false = rotas de dados aceitam anônimo e só registram WARNING (período de transição)
# true  = rotas de dados exigem token (401 sem ele)
AUTH_OBRIGATORIA=false

# NFSe Recife - Configurações
NFSE_CNPJ=08857492000148
NFSE_INSCRICAO_MUNICIPAL=3694208

# ===== CERTIFICADOS NFSe =====
# Você pode configurar de 2 formas:

# OPÇÃO 1: Caminhos locais (desenvolvimento/local)
# NFSE_CERT_PATH=C:/NFSe/cert.crt
# NFSE_KEY_PATH=C:/NFSe/key.key

# OPÇÃO 2: Base64 (produção/Easypanel) - RECOMENDADO
# Para gerar o base64 dos certificados, use:
# Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("C:\caminho\cert.crt"))
# Linux/Mac: base64 -w 0 /caminho/cert.crt
#
# Cole o resultado completo (uma linha só) nas variáveis abaixo:
NFSE_CERT_BASE64=
NFSE_KEY_BASE64=
