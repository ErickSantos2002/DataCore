# Duas vezes por dia: a reconstrucao da madrugada e a da tarde.
#
# Por que 05:00 e nao mais tarde: as cargas do dia sao notas 04:00 e 15:00, contas 10:00 e
# estoque 16:00. Rodar as 05:00 (02:00 no Brasil) pega as notas do dia — que e o que manda
# no faturamento — e mantem o trabalho pesado fora do expediente. Contas e estoque entram
# com a carga da vespera; para faturamento diario isso nao muda conclusao nenhuma.
# Se um dia o gold precisar de contas do mesmo dia, o horario passa para depois das 16:00.
#
# A DAS 17:45 UTC (14:45 no Brasil) entrou em 2026-09-19 e e a que faz o numero do dia
# aparecer: sem ela, a carga de notas da tarde so encheria o bronze, e a tela continuaria
# mostrando o gold da madrugada. Roda 15 min depois da carga de notas (~3,5 min) e 10 min
# depois das NFS-e (~20s), com folga de sobra, e termina em ~15s — pronto as 14:46, antes
# das 15h, que e quando o pessoal olha.
#
# ⚠️ `dbt build` roda os snapshots junto, entao o historico SCD2 passa a ter duas fotos por
# dia em vez de uma. Nao e problema — e mais granularidade, nao menos.
[Unit]
Description=Reconstrucao da camada analitica do DataCore (madrugada e tarde)

[Timer]
OnCalendar=*-*-* 05:00:00 UTC
OnCalendar=*-*-* 17:45:00 UTC
# Persistent: se a VPS estiver desligada na hora, roda assim que voltar. O historico SCD2
# so guarda o que rodou — dia perdido nao volta.
Persistent=true
Unit=datacore-dbt.service

[Install]
WantedBy=timers.target
